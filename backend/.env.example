# Entorno: development | production | testing
FLASK_ENV=development
FLASK_APP=run.py

# Claves secretas (genera valores aleatorios largos en producción:
#   python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Base de datos (PostgreSQL en producción)
DATABASE_URL=postgresql+psycopg2://gestor:gestor@localhost:5432/gestor_documental

# Expiración de tokens (en segundos)
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Orígenes CORS permitidos (separados por comas)
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:5000

# Subidas
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=15

# Branding del informe PDF
COMPANY_NAME=Mi Empresa S.L.
COMPANY_LOGO_PATH=
