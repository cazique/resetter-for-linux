#!/bin/bash
set -euo pipefail

# Configuración
# Las rutas ahora apuntan a la estructura dentro del repositorio
SCRIPT_DIR="./resetter"
CONFIG_DIR="./resetter-data/config"
LOG_FILE="./resetter-data/logs/resetter.log"

# Cargar módulos
source "$SCRIPT_DIR/src/core/error_handler.sh"
source "$SCRIPT_DIR/src/core/distribution_detector.sh"
source "$SCRIPT_DIR/src/ui/language_manager.sh"
source "$SCRIPT_DIR/src/ui/interactive_menu.sh"
source "$SCRIPT_DIR/src/backup/backup_manager.sh"
source "$SCRIPT_DIR/src/dryrun/dry_run_simulator.sh"
source "$SCRIPT_DIR/src/reset/grub_manager.sh"

# Inicialización
initialize_resetter() {
    # Crear directorios necesarios
    mkdir -p "${CONFIG_DIR}" "${LOG_FILE%/*}"

    # Configurar logging
    exec > >(tee -a "$LOG_FILE")
    exec 2>&1

    # Verificar requisitos (adaptado para no fallar en este entorno)
    # check_prerequisites

    # Detectar distribución
    detect_current_distribution

    # Cargar idioma
    load_language_texts "auto"

    log_success "Resetter for Linux inicializado"
}

# Menú principal
main_menu() {
    while true; do
        clear
        echo "================================================"
        echo "           RESETTER FOR LINUX"
        echo "================================================"
        echo "Distribución: $CURRENT_DISTRO_NAME"
        echo "Idioma: $CURRENT_LANGUAGE"
        echo "================================================"
        echo "1. $(t BACKUP_MENU "Copia de Seguridad")"
        echo "2. $(t RESET_MENU "Restablecer Sistema")"
        echo "3. $(t DRY_RUN_MENU "Simulación Dry Run")"
        echo "4. $(t REPORT_MENU "Generar Reporte")"
        echo "5. $(t RESTORE_MENU "Restaurar Backup")"
        echo "6. $(t SETTINGS_MENU "Configuración")"
        echo "7. $(t EXIT_MENU "Salir")"
        echo "================================================"

        read -p "$(t SELECT_OPTION "Selecciona una opción"): " choice

        case $choice in
            1) backup_menu ;;
            2) reset_menu ;;
            3) dry_run_menu ;;
            4) report_menu ;;
            5) restore_menu ;;
            6) settings_menu ;;
            7) exit 0 ;;
            *) echo "$(t INVALID_OPTION "Opción no válida")"; sleep 2 ;;
        esac
    done
}

# Manejar señales
trap 'log_error "Script interrumpido por el usuario"; exit 1' INT TERM

# Función principal
main() {
    log_info "Iniciando Resetter for Linux..."

    initialize_resetter

    # Mostrar advertencia de seguridad
    show_safety_warning

    # Ejecutar menú principal
    main_menu
}

# Ejecutar
main "$@"
