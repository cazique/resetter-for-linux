# Base de datos: SQLite en desarrollo, PostgreSQL en producción
DATABASE_URL=sqlite:///./gestion_costes.db
# DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/gestion_costes

# Proveedor de visión: "gemini" u "openai"
OCR_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Por debajo de esta confianza (0-1) la factura se marca para revisión manual
OCR_UMBRAL_CONFIANZA=0.80
# Tarifa por km por defecto (0,26 €/km exenta de IRPF desde 07/2023)
TARIFA_KM_DEFECTO=0.26
